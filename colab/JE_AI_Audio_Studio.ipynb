    "# Lightweight DSP/arrangement smoke test using pYIN fallback; no heavy neural model inference.\n",
    "import numpy as np, soundfile as sf\n",
    "from ai.arrangement_generator import AIConditionedArrangementConfig, generate_ai_conditioned_arrangement\n",
    "sr = 22050\n",
    "t = np.arange(sr * 2) / sr\n",
    "demo_path = '/content/je_ai_smoke.wav'\n",
    "sf.write(demo_path, 0.15 * np.sin(2 * np.pi * 220.0 * t).astype(np.float32), sr)\n",
    "result = generate_ai_conditioned_arrangement(demo_path, config=AIConditionedArrangementConfig(bars=2, melody_backend='pyin'))\n",
    "print('✅ Conditioned arrangement smoke test:', result['bpm'], result['key'], result['scale'], result['melody_backend'])"
   ]
